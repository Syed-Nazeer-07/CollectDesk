NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/collectdesk_demo
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
DEMO_SEED_PASSWORD=change-this-before-seeding

# Optional self-service creditor registration (disabled unless explicitly true).
# Choose ONE verification sender. Public signup stays disabled until a sender is configured.
PUBLIC_REGISTRATION_ENABLED=false
# Option A: Resend with a verified sending domain
RESEND_API_KEY=
AUTH_FROM_EMAIL=
# Option B: Brevo HTTPS API (works on Render Free; verified sender required)
BREVO_API_KEY=
BREVO_FROM_EMAIL=
# Option C: Gmail SMTP (local or hosts allowing SMTP; NOT Render Free)
# Use a Gmail App Password, never your regular account password.
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
# Paid Render instances ONLY, after verifying SMTP egress is allowed:
ALLOW_SMTP_ON_RENDER=false
# Google Identity Services (OAuth web client ID only; no secret in the browser).
GOOGLE_CLIENT_ID=
